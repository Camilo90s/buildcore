---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import baker from '../assets/images/baker-flour.jpg';
---

<section id="about" aria-labelledby="about-title" class="container-x">
  <div
    class="relative grid overflow-hidden rounded-[24px] bg-cream p-3 sm:p-[13px] lg:min-h-[415px] lg:grid-cols-[433px_1fr] lg:gap-[85px] xl:grid-cols-[470px_1fr]"
  >
    <!-- Foto con borde derecho en arco + media luna naranja -->
    <div class="about-photo relative mr-7 lg:mr-0" data-reveal="left">
      <Image
        src={baker}
        alt="Baker sprinkling flour over fresh dough on a wooden table"
        widths={[420, 640, 860]}
        sizes="(min-width: 1280px) 470px, (min-width: 1024px) 433px, 92vw"
        loading="lazy"
        class="relative z-10 rounded-[20px_95px_95px_20px/20px_50%_50%_20px] aspect-[4/3] h-full w-full object-cover lg:aspect-auto"
      />
    </div>

    <div class="relative px-3 pt-8 pb-8 sm:px-6 lg:px-0 lg:pt-[44px] lg:pr-10 lg:pb-[60px]">
      <!-- Destellos decorativos -->
      <svg
        class="absolute top-6 right-4 h-[38px] w-[44px] text-brand lg:top-[50px] lg:right-[36px]"
        viewBox="0 0 44 38"
        fill="none"
        stroke="currentColor"
        stroke-width="3"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M9 3.5 7.5 14M24 9.5 16.5 17.5M37 27H25.5"></path>
      </svg>

      <p class="text-[17px] font-bold sm:text-[19px]" data-reveal>
        <span class="text-[#c57a35]">About</span>
        <span class="text-brand-600">Bakery.com</span>
      </p>
      <h2
        id="about-title"
        class="mt-3 text-[30px] leading-[1.2] font-bold tracking-[-0.015em] text-ink-brown sm:text-[36px] lg:mt-[15px] lg:text-[40px] lg:leading-[50px]"
        data-reveal
        style="--delay:80ms"
      >
        Baked with Passion,<br />Served with Care
      </h2>
      <p class="mt-4 max-w-[440px] text-[16px] leading-[24px] text-[#4d4a48]" data-reveal style="--delay:160ms">
        At Bakery.com, we believe every bite should bring happiness. Our bakers use the finest ingredients to
        create delicious treats for your special moments.
      </p>
      <div class="mt-6 lg:mt-[25px]" data-reveal style="--delay:240ms">
        <a href="#gallery" class="btn btn-dark h-[52px] px-8 text-[16px] lg:h-[57px] lg:w-[188px] lg:text-[17px]">
          Learn More
          <Icon name="arrow" class="arrow h-[18px] w-[18px]" strokeWidth={2.4} />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Media luna naranja detrás de la foto (misma forma, desplazada) */
  .about-photo::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 20px 95px 95px 20px / 20px 50% 50% 20px;
    background: var(--color-brand-light);
    transform: translateX(26px);
  }
</style>
