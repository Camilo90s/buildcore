---
import { Image } from 'astro:assets';
import { gallery } from '../data/site';
---

<section id="gallery" aria-labelledby="gallery-title" class="pb-16 lg:pb-24">
  <div class="container-x">
    <div class="text-center">
      <p class="eyebrow" data-reveal>Our Gallery</p>
      <h2 id="gallery-title" class="section-title mt-2.5" data-reveal style="--delay:80ms">
        Fresh from <span class="text-brand">Our Oven</span>
      </h2>
    </div>

    <ul class="mt-8 grid grid-cols-2 gap-3 sm:gap-4 lg:mt-10 lg:grid-cols-4 lg:grid-rows-[230px_230px] lg:gap-5">
      {
        gallery.map((g, i) => (
          <li
            data-reveal="zoom"
            style={`--delay:${i * 90}ms`}
            class:list={[g.span === 'big' ? 'col-span-2 lg:row-span-2' : 'aspect-square lg:aspect-auto']}
          >
            <figure class="group relative h-full overflow-hidden rounded-[18px]">
              <Image
                src={g.image}
                alt={g.alt}
                widths={g.span === 'big' ? [480, 720, 880] : [320, 480, 660]}
                sizes={g.span === 'big' ? '(min-width: 1024px) 560px, 100vw' : '(min-width: 1024px) 275px, 50vw'}
                loading="lazy"
                class:list={[
                  'h-full w-full object-cover transition-transform duration-[1.2s] ease-out-expo group-hover:scale-110',
                  g.span === 'big' && 'aspect-[16/11] lg:aspect-auto',
                ]}
              />
              <figcaption class="absolute inset-0 flex items-end bg-linear-to-t from-espresso/85 via-espresso/10 to-transparent p-4 opacity-100 transition-opacity duration-500 lg:opacity-0 lg:group-hover:opacity-100">
                <span class="translate-y-0 text-[15px] font-bold text-white transition-transform duration-500 ease-out-expo lg:translate-y-3 lg:group-hover:translate-y-0">
                  {g.label}
                </span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>
