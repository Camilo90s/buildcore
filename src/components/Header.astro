---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { contact, nav, social } from '../data/site';
---

<!-- Barra superior -->
<div class="bg-cocoa text-[13.5px] text-white/90">
  <div class="container-x flex h-[40px] items-center justify-between lg:h-[45px]">
    <ul class="flex items-center gap-6 lg:gap-[46px]">
      {
        contact.map((item, i) => (
          <li class:list={['items-center gap-2.5', i === 0 ? 'flex' : i === 1 ? 'hidden sm:flex' : 'hidden md:flex']}>
            <Icon name={item.icon} class="h-[15px] w-[15px] text-brand-light" />
            {item.href ? (
              <a href={item.href} class="font-medium transition-colors hover:text-brand-light">
                {item.label}
              </a>
            ) : (
              <span class="font-medium">{item.label}</span>
            )}
          </li>
        ))
      }
    </ul>
    <ul class="flex items-center gap-2.5 lg:gap-3">
      {
        social.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener"
              aria-label={s.label}
              class="grid h-[28px] w-[28px] place-items-center rounded-full border border-white/40 text-white transition-[background-color,border-color,color,translate] duration-300 hover:-translate-y-0.5 hover:border-brand hover:bg-brand"
            >
              <Icon name={s.icon} class="h-[15px] w-[15px]" strokeWidth={2.2} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<header
  data-site-header
  data-scrolled="false"
  class="sticky top-0 z-50 bg-white transition-[background-color,box-shadow] duration-300 data-[scrolled=true]:bg-white/90 data-[scrolled=true]:shadow-[0_12px_30px_-18px_rgb(43_17_4/0.45)] data-[scrolled=true]:backdrop-blur-md data-[scrolled=true]:backdrop-saturate-150"
>
  <div class="container-x flex h-[72px] items-center lg:h-[100px]">
    <a href="#home" class="shrink-0" aria-label="Bakery.com — Home">
      <Logo />
    </a>

    <nav aria-label="Main navigation" class="ml-auto hidden lg:block">
      <ul class="flex items-center gap-[28px] xl:gap-[34px]">
        {
          nav.map((item, i) => (
            <li>
              <a
                href={item.href}
                data-nav-link
                aria-current={i === 0 ? 'true' : undefined}
                class="relative block py-1 text-[17px] font-medium text-[#3b3d44] transition-colors duration-300 after:absolute after:inset-x-0 after:top-[calc(100%+8px)] after:h-[2.5px] after:origin-left after:scale-x-0 after:rounded-full after:bg-brand after:transition-transform after:duration-500 after:ease-out-expo hover:text-brand aria-[current=true]:font-semibold aria-[current=true]:text-[#c4510a] aria-[current=true]:after:scale-x-100"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-2 lg:ml-[39px] lg:gap-[16px]">
      <a
        href="#menu"
        aria-label="Search our menu"
        class="grid h-10 w-10 place-items-center rounded-full text-[#2a2c33] transition-colors hover:bg-brand-50 hover:text-brand"
      >
        <Icon name="search" class="h-[21px] w-[21px]" strokeWidth={2.2} />
      </a>
      <a href="#menu" class="btn btn-primary hidden h-[42px] gap-2.5 px-[20px] text-[14.5px] sm:inline-flex">
        Order Now
        <Icon name="arrow" class="arrow h-4 w-4" strokeWidth={2.4} />
      </a>
      <button
        type="button"
        class="group grid h-10 w-10 place-items-center rounded-full text-ink transition-colors hover:bg-brand-50 lg:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Open menu"
        data-menu-toggle
      >
        <span class="relative block h-[14px] w-[22px]" aria-hidden="true">
          <span class="absolute top-0 left-0 h-[2px] w-full rounded bg-current transition-transform duration-300 ease-out-expo group-aria-expanded:translate-y-[6px] group-aria-expanded:rotate-45"></span>
          <span class="absolute top-[6px] left-0 h-[2px] w-full rounded bg-current transition-opacity duration-200 group-aria-expanded:opacity-0"></span>
          <span class="absolute top-[12px] left-0 h-[2px] w-full rounded bg-current transition-transform duration-300 ease-out-expo group-aria-expanded:-translate-y-[6px] group-aria-expanded:-rotate-45"></span>
        </span>
      </button>
    </div>
  </div>

  <!-- Barra de progreso de lectura -->
  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-[3px]" aria-hidden="true">
    <div class="scroll-progress h-full w-full bg-brand"></div>
  </div>

  <div
    id="mobile-menu"
    data-open="false"
    inert
    class="invisible absolute inset-x-0 top-full -translate-y-2 border-t border-line bg-white opacity-0 shadow-[0_18px_30px_-18px_rgb(43_17_4/0.45)] transition-[opacity,translate,visibility] duration-300 ease-out-expo data-[open=true]:visible data-[open=true]:translate-y-0 data-[open=true]:opacity-100 lg:hidden"
  >
    <nav aria-label="Mobile navigation" class="container-x pt-2 pb-6">
      <ul class="divide-y divide-line">
        {
          nav.map((item, i) => (
            <li
              class="translate-x-[-12px] opacity-0 transition-[opacity,translate] duration-500 ease-out-expo in-data-[open=true]:translate-x-0 in-data-[open=true]:opacity-100"
              style={`transition-delay:${60 + i * 45}ms`}
            >
              <a
                href={item.href}
                data-nav-link
                aria-current={i === 0 ? 'true' : undefined}
                class="group/link flex items-center justify-between py-4 text-[17px] font-medium text-[#3b3d44] aria-[current=true]:font-semibold aria-[current=true]:text-[#c4510a]"
              >
                {item.label}
                <Icon name="arrow" class="h-4 w-4 text-brand transition-transform duration-300 group-hover/link:translate-x-1" />
              </a>
            </li>
          ))
        }
      </ul>
      <a href="#menu" class="btn btn-primary mt-5 h-[50px] w-full text-[16px] sm:hidden">
        Order Now
        <Icon name="arrow" class="arrow h-4 w-4" strokeWidth={2.4} />
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    menu.dataset.open = String(open);
    menu.toggleAttribute('inert', !open);
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  window.matchMedia('(min-width: 64rem)').addEventListener('change', (e) => e.matches && setOpen(false));

  // Sombra + desenfoque del header al hacer scroll.
  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      header?.setAttribute('data-scrolled', String(window.scrollY > 50));
      ticking = false;
    });
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Menú activo según la sección visible.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const sections = [...new Set(links.map((a) => a.hash))]
    .map((hash) => document.querySelector<HTMLElement>(hash))
    .filter((el): el is HTMLElement => Boolean(el));

  if ('IntersectionObserver' in window && sections.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const hash = `#${entry.target.id}`;
          links.forEach((a) => (a.hash === hash ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => observer.observe(s));
  }
</script>
