---
import Logo from './Logo.astro';
import ArrowRight from './ArrowRight.astro';
import { nav } from '../data/site';
---

<header
  class="sticky top-0 z-50 bg-[#fbfcfe] shadow-[0_1px_0_rgb(15_23_42/0.06),0_8px_20px_-14px_rgb(15_23_42/0.35)]"
>
  <div
    class="mx-auto flex h-[72px] max-w-[1440px] items-center px-5 sm:px-8 lg:h-[96px] xl:h-[114px] xl:px-[52px]"
  >
    <a href="#home" class="shrink-0" aria-label="BuildCore Construction — Home">
      <Logo />
    </a>

    <nav aria-label="Main navigation" class="ml-auto hidden xl:block">
      <ul class="flex items-center gap-10 min-[1400px]:gap-[58px]">
        {
          nav.map((item, i) => (
            <li>
              <a
                href={item.href}
                data-nav-link
                aria-current={i === 0 ? 'true' : undefined}
                class="relative block py-2 text-[17.5px] font-medium text-[#4d4f53] transition-colors after:absolute after:inset-x-0 after:top-[calc(100%+9px)] after:h-[2px] after:origin-left after:scale-x-0 after:bg-brand after:transition-transform after:duration-300 hover:text-ink aria-[current=true]:font-semibold aria-[current=true]:text-ink aria-[current=true]:after:scale-x-100"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-3 xl:ml-10 min-[1400px]:ml-[58px]">
      <a
        href="#contact"
        class="hidden h-[46px] items-center gap-6 rounded-[4px] bg-brand px-6 font-display text-[15px] font-bold tracking-[0.01em] text-[#1d1505] uppercase shadow-[0_6px_16px_-8px_rgb(246_176_36/0.7)] transition-colors hover:bg-brand-600 sm:inline-flex lg:h-[52px] xl:h-[58px] xl:px-[30px] xl:text-[17px]"
      >
        Get a quote
        <ArrowRight class="h-[18px] w-[18px]" />
      </a>

      <button
        type="button"
        class="group inline-flex h-11 w-11 items-center justify-center rounded-[4px] text-ink hover:bg-black/5 xl:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Open menu"
        data-menu-toggle
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path class="group-aria-expanded:hidden" d="M4 7h16M4 12h16M4 17h16"></path>
          <path class="hidden group-aria-expanded:block" d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="absolute inset-x-0 top-full border-t border-line bg-white shadow-[0_18px_30px_-18px_rgb(2_20_32/0.45)] xl:hidden"
    hidden
  >
    <nav aria-label="Mobile navigation" class="mx-auto max-w-[1440px] px-5 pt-2 pb-6 sm:px-8">
      <ul class="divide-y divide-line">
        {
          nav.map((item, i) => (
            <li>
              <a
                href={item.href}
                data-nav-link
                aria-current={i === 0 ? 'true' : undefined}
                class="flex items-center justify-between py-4 text-[17px] font-medium text-[#3f4246] aria-[current=true]:font-semibold aria-[current=true]:text-ink"
              >
                {item.label}
                <ArrowRight class="h-4 w-4 text-brand" />
              </a>
            </li>
          ))
        }
      </ul>
      <a href="#contact" class="btn btn-primary mt-5 w-full sm:hidden">
        Get a quote
        <ArrowRight class="h-[18px] w-[18px]" />
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    menu.hidden = !open;
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  window.matchMedia('(min-width: 80rem)').addEventListener('change', (e) => e.matches && setOpen(false));

  // Resalta en el menú la sección visible (subrayado amarillo como en el diseño).
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const sections = [...new Set(links.map((a) => a.hash))]
    .map((hash) => document.querySelector<HTMLElement>(hash))
    .filter((el): el is HTMLElement => Boolean(el));

  if ('IntersectionObserver' in window && sections.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const hash = `#${entry.target.id}`;
          links.forEach((a) => (a.hash === hash ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => observer.observe(s));
  }
</script>
