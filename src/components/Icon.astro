---
// Iconos SVG en línea (sin peticiones extra). Trazo = currentColor.
type Name =
  | 'phone' | 'mail' | 'pin' | 'search' | 'arrow' | 'play' | 'cart' | 'star' | 'clock' | 'calendar' | 'check'
  | 'facebook' | 'instagram' | 'youtube' | 'linkedin'
  | 'cupcake' | 'heart' | 'truck' | 'smile';

interface Props {
  name: Name;
  class?: string;
  strokeWidth?: number;
}

const { name, class: className = 'h-5 w-5', strokeWidth = 2 } = Astro.props;

const filled: Partial<Record<Name, string>> = {
  play: 'M8 5.5v13a.6.6 0 0 0 .9.5l10.2-6.5a.6.6 0 0 0 0-1L8.9 5a.6.6 0 0 0-.9.5Z',
  star: 'm12 2.8 2.8 5.7 6.3.9-4.6 4.4 1.1 6.2L12 17l-5.6 3 1.1-6.2L2.9 9.4l6.3-.9Z',
  facebook: 'M13.5 21v-7.6h2.6l.4-3h-3V8.5c0-.9.3-1.5 1.5-1.5h1.6V4.3c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H7.9v3h2.6V21Z',
  youtube: 'M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.3 5 12 5 12 5s-6.3 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2C2 8.8 2 12 2 12s0 3.2.4 4.8a2.5 2.5 0 0 0 1.8 1.8C5.7 19 12 19 12 19s6.3 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8c.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8ZM10 15V9l5.2 3Z',
  linkedin: 'M6.9 8.8H3.6V20h3.3ZM5.2 3.5a1.9 1.9 0 1 0 0 3.8 1.9 1.9 0 0 0 0-3.8ZM20.4 13.6c0-3-1.6-5-4.3-5a3.7 3.7 0 0 0-3.3 1.8V8.8H9.6V20h3.3v-5.6c0-1.5.3-2.9 2.1-2.9s1.9 1.7 1.9 3V20h3.4Z',
};

const stroked: Partial<Record<Name, string>> = {
  phone: 'M5 4h3.2l1.6 4.2-2.1 1.3a11 11 0 0 0 5.8 5.8l1.3-2.1L19 14.8V18a1.5 1.5 0 0 1-1.6 1.5A15.5 15.5 0 0 1 3.5 5.6 1.5 1.5 0 0 1 5 4Z',
  mail: 'M3.5 6.5h17v11h-17Zm.5.5 8 6 8-6',
  pin: 'M12 21s-6.5-5.8-6.5-11a6.5 6.5 0 0 1 13 0C18.5 15.2 12 21 12 21Zm0-8.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
  search: 'M10.8 18a7.2 7.2 0 1 0 0-14.4 7.2 7.2 0 0 0 0 14.4Zm5.2-2 4.5 4.5',
  arrow: 'M4.5 12h14.5M13.5 6l6 6-6 6',
  cart: 'M3 4h2.2l2.1 10.2a1.5 1.5 0 0 0 1.5 1.2h8.4a1.5 1.5 0 0 0 1.5-1.1L20.5 8H6.2M9.5 20a.8.8 0 1 0 0-1.6.8.8 0 0 0 0 1.6Zm8 0a.8.8 0 1 0 0-1.6.8.8 0 0 0 0 1.6ZM10.5 11h6',
  clock: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0-13.5V12l3 2',
  calendar: 'M4.5 6.5h15v13h-15Zm0 4h15M8.5 4v4M15.5 4v4',
  check: 'm5 12.5 4.5 4.5L19 7.5',
  instagram: 'M7.5 3.5h9a4 4 0 0 1 4 4v9a4 4 0 0 1-4 4h-9a4 4 0 0 1-4-4v-9a4 4 0 0 1 4-4Zm4.5 12.2a3.7 3.7 0 1 0 0-7.4 3.7 3.7 0 0 0 0 7.4Zm5-9.4v.1',
  // Glifos blancos dentro del corazón de "features"
  cupcake: 'M6.5 11.5h11l-1.4 8a1 1 0 0 1-1 .8H8.9a1 1 0 0 1-1-.8ZM9.5 11.5l.6 8.8M14.5 11.5l-.6 8.8M12 11.5v8.8M6 11.5a2.8 2.8 0 0 1 .7-5.2 3.4 3.4 0 0 1 6.1-1.7 3 3 0 0 1 4.6 2.8A2.3 2.3 0 0 1 18 11.5',
  truck: 'M2.5 7h11v8.5h-11Zm11 3h4l3 3v2.5h-7M6.5 18.5a1.8 1.8 0 1 0 0-3.6 1.8 1.8 0 0 0 0 3.6Zm11 0a1.8 1.8 0 1 0 0-3.6 1.8 1.8 0 0 0 0 3.6Z',
  smile: 'M8 14.5c1 1.6 2.4 2.4 4 2.4s3-.8 4-2.4M8.8 9.5v.5M15.2 9.5v.5',
};

const heartFill = 'M12 20.2s-7.7-4.6-7.7-10.4A4.5 4.5 0 0 1 12 7a4.5 4.5 0 0 1 7.7 2.8c0 5.8-7.7 10.4-7.7 10.4Z';
---

{
  name === 'heart' ? (
    <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
      <path d={heartFill} />
    </svg>
  ) : filled[name] ? (
    <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
      <path d={filled[name]} />
    </svg>
  ) : (
    <svg
      class={className}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width={strokeWidth}
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <path d={stroked[name]} />
    </svg>
  )
}
