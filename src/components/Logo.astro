---
interface Props {
  variant?: 'dark' | 'light';
  class?: string;
}
const { variant = 'dark', class: className } = Astro.props;
---

<span class:list={['flex items-center gap-2.5', className]}>
  <svg class="h-9 w-8 shrink-0 lg:h-[42px] lg:w-[38px]" viewBox="0 0 36 40" aria-hidden="true" focusable="false">
    <!-- Crema -->
    <path
      fill="#EB650C"
      d="M7 19.5a6 6 0 0 1-1.2-11.7 5.5 5.5 0 0 1 7.6-4.3A6.5 6.5 0 0 1 24.7 4a5.6 5.6 0 0 1 6.6 5.4A5.3 5.3 0 0 1 29 19.5Z"
    ></path>
    <circle cx="18" cy="3.2" r="2.6" fill="#EB650C"></circle>
    <path d="M11 11.5c1.2-1.6 3-2.4 5-2.2" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" opacity=".85"></path>
    <!-- Cápsula -->
    <path
      d="M4.5 19.5h27l-2.6 17.2a2 2 0 0 1-2 1.8H9.1a2 2 0 0 1-2-1.8Z"
      fill="none"
      stroke={variant === 'light' ? '#fff' : '#2a1a12'}
      stroke-width="2.6"
      stroke-linejoin="round"></path>
    <path
      d="M12.5 20v18M18 20v18M23.5 20v18"
      stroke={variant === 'light' ? '#fff' : '#2a1a12'}
      stroke-width="2.4"
      stroke-linecap="round"></path>
  </svg>
  <span
    class:list={[
      'text-[23px] leading-none font-extrabold tracking-[-0.025em] lg:text-[28px]',
      variant === 'light' ? 'text-white' : 'text-[#15161b]',
    ]}
  >
    Bakery<span class="text-brand">.com</span>
  </span>
</span>
