---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { products } from '../data/site';

const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
---

<section id="menu" aria-labelledby="menu-title" class="pt-10 pb-16 lg:pt-[38px] lg:pb-[50px]">
  <div class="container-x">
    <div class="text-center">
      <p class="eyebrow" data-reveal>Our Popular Items</p>
      <h2 id="menu-title" class="section-title mt-3 lg:leading-[44px]" data-reveal style="--delay:80ms">
        Delicious Bakes for <span class="text-brand">Every Mood</span>
      </h2>
      <p class="mx-auto mt-2 max-w-[540px] text-[15.5px] leading-[23px] text-muted" data-reveal style="--delay:160ms">
        From classic favorites to unique creations, our bakery has something special for everyone.
      </p>
    </div>

    <ul class="mt-8 grid grid-cols-2 gap-3.5 sm:gap-5 lg:mt-[26px] lg:grid-cols-4 lg:gap-[26px]">
      {
        products.map((p, i) => (
          <li data-reveal style={`--delay:${i * 110}ms`}>
            <article class="group flex h-full flex-col overflow-hidden rounded-[14px] border border-[#f1ebe6] bg-white shadow-[0_10px_28px_-16px_rgb(43_17_4/0.28)] transition-[translate,box-shadow] duration-500 ease-out-expo hover:-translate-y-1.5 hover:shadow-[0_24px_40px_-20px_rgb(43_17_4/0.4)]">
              <div class="relative aspect-[10/9] overflow-hidden">
                <Image
                  src={p.image}
                  alt={p.alt}
                  widths={[240, 360, 480, 660]}
                  sizes="(min-width: 1200px) 276px, (min-width: 1024px) 23vw, 48vw"
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-[1.2s] ease-out-expo group-hover:scale-110"
                />
              </div>
              <div class="flex flex-1 flex-col items-center px-3 pt-4 pb-4 text-center sm:pt-[18px] sm:pb-[20px]">
                <h3 class="text-[14.5px] leading-6 font-bold text-[#17181d] sm:text-[16.5px]">{p.name}</h3>
                <p class="mt-1.5 text-[19px] leading-6 font-bold text-brand sm:mt-[9px] sm:text-[21px]">{money.format(p.price)}</p>
                <button
                  type="button"
                  data-add-to-cart={p.name}
                  class="btn btn-primary mt-3.5 h-[38px] w-full max-w-[155px] gap-2 px-3 text-[13px] sm:mt-[15px] sm:h-[40px] sm:text-[14px]"
                >
                  <Icon name="cart" class="h-[17px] w-[17px] shrink-0" strokeWidth={2} />
                  <span data-label>Add to Cart</span>
                </button>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
  <p class="sr-only" aria-live="polite" data-cart-status></p>
</section>

<script>
  // Demo: feedback visual al añadir. Conecta aquí tu carrito real (Shopify, Snipcart, etc.).
  const status = document.querySelector<HTMLElement>('[data-cart-status]');
  document.querySelectorAll<HTMLButtonElement>('[data-add-to-cart]').forEach((btn) => {
    const label = btn.querySelector<HTMLElement>('[data-label]');
    let timer: number | undefined;
    btn.addEventListener('click', () => {
      if (!label) return;
      btn.classList.remove('is-added');
      void btn.offsetWidth; // reinicia la animación
      btn.classList.add('is-added');
      label.textContent = 'Added!';
      if (status) status.textContent = `${btn.dataset.addToCart} added to cart`;
      window.clearTimeout(timer);
      timer = window.setTimeout(() => (label.textContent = 'Add to Cart'), 1600);
    });
  });
</script>
