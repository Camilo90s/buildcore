---
import Icon from './Icon.astro';
import { testimonials } from '../data/site';

const initials = (name: string) =>
  name
    .split(' ')
    .map((n) => n[0])
    .join('');
---

<section aria-labelledby="reviews-title" class="pt-14 pb-16 lg:pt-[22px] lg:pb-[60px]">
  <div class="container-x">
    <div class="text-center">
      <p class="eyebrow" data-reveal>What Our Customers Say</p>
      <h2 id="reviews-title" class="section-title mt-2.5 lg:text-[33px] lg:leading-[40px]" data-reveal style="--delay:80ms">
        Trusted by Thousands of <span class="text-brand">Happy Customers</span>
      </h2>
    </div>

    <ul
      data-slider
      class="-mx-5 mt-8 flex snap-x snap-mandatory scroll-px-5 gap-3 overflow-x-auto px-5 pb-6 [scrollbar-width:none] sm:-mx-6 sm:scroll-px-6 sm:px-6 lg:mx-0 lg:mt-[28px] lg:grid lg:grid-cols-3 lg:overflow-visible lg:px-0 lg:pb-0 [&::-webkit-scrollbar]:hidden"
    >
      {
        testimonials.map((t, i) => (
          <li class="w-[86%] max-w-[360px] shrink-0 snap-start sm:w-[48%] lg:w-auto lg:max-w-none" data-slide>
            <figure
              data-reveal
              style={`--delay:${i * 120}ms`}
              class="group flex h-full flex-col rounded-[18px] border border-[#f2eeea] bg-white px-[26px] pt-[24px] pb-[22px] shadow-[0_14px_34px_-20px_rgb(43_17_4/0.3)] transition-[translate,box-shadow] duration-500 ease-out-expo hover:-translate-y-1.5 hover:shadow-[0_26px_44px_-22px_rgb(43_17_4/0.42)] lg:min-h-[250px]"
            >
              <svg class="h-[26px] w-[32px] text-brand transition-transform duration-500 ease-out-expo group-hover:-rotate-6" viewBox="0 0 32 26" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M0 26V15.6C0 7.4 4.3 2.2 12.4 0l1.8 3.6C9.7 5 7.4 7.9 7.2 11.8H13V26Zm18.6 0V15.6C18.6 7.4 22.9 2.2 31 0l1 3.6c-4.5 1.4-6.8 4.3-7 8.2H31V26Z"
                />
              </svg>
              <blockquote class="mt-[12px] flex-1 text-[16px] leading-[24px] whitespace-pre-line text-[#3b3b40] sm:text-[17px] sm:leading-[25px]">
                “{t.quote}”
              </blockquote>
              <figcaption class="mt-5 flex items-center gap-[14px]">
                <span
                  class="grid h-[64px] w-[64px] shrink-0 place-items-center rounded-full text-[20px] font-bold text-white ring-4 ring-[#f6efe9] lg:h-[76px] lg:w-[76px] lg:text-[22px]"
                  style={`background:${t.color}`}
                  aria-hidden="true"
                >
                  {initials(t.name)}
                </span>
                <span class="flex flex-col">
                  <span class="text-[15.5px] leading-5 font-bold text-[#1d1a19]">{t.name}</span>
                  <span class="mt-0.5 text-[12.5px] leading-5 text-[#6e6e73]">{t.location}</span>
                  <span class="mt-1.5 flex gap-[3px] text-star" role="img" aria-label="Rated 5 out of 5">
                    {[0, 1, 2, 3, 4].map(() => (
                      <Icon name="star" class="h-[15px] w-[15px]" />
                    ))}
                  </span>
                </span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>

    <div class="mt-6 flex justify-center gap-3 lg:mt-[35px]" data-dots>
      {
        testimonials.map((t, i) => (
          <button
            type="button"
            class="h-[14px] w-[14px] rounded-full bg-[#d9d9d9] transition-[background-color,scale] duration-300 aria-[current=true]:scale-110 aria-[current=true]:bg-[#e36f19]"
            aria-label={`Show review ${i + 1}`}
            aria-current={i === 0 ? 'true' : undefined}
            data-dot={i}
          />
        ))
      }
    </div>
  </div>
</section>

<script>
  // Slider con scroll-snap nativo: los puntos siguen al deslizar y permiten saltar.
  const slider = document.querySelector<HTMLElement>('[data-slider]');
  const slides = [...document.querySelectorAll<HTMLElement>('[data-slide]')];
  const dots = [...document.querySelectorAll<HTMLButtonElement>('[data-dot]')];

  const setActive = (index: number) =>
    dots.forEach((d, i) => (i === index ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));

  const syncInteractivity = () => {
    // En escritorio caben las 3 tarjetas: los puntos quedan como indicador decorativo.
    const scrollable = !!slider && slider.scrollWidth > slider.clientWidth + 4;
    dots.forEach((d) => {
      d.tabIndex = scrollable ? 0 : -1;
      d.toggleAttribute('aria-hidden', !scrollable);
    });
    if (!scrollable) setActive(0);
  };

  dots.forEach((dot, i) =>
    dot.addEventListener('click', () => slider?.scrollTo({ left: slides[i].offsetLeft - slider.offsetLeft - 20, behavior: 'smooth' })),
  );

  if (slider && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        if (slider.scrollWidth <= slider.clientWidth + 4) return;
        entries.forEach((e) => e.isIntersecting && setActive(slides.indexOf(e.target as HTMLElement)));
      },
      { root: slider, threshold: 0.6 },
    );
    slides.forEach((s) => io.observe(s));
  }

  syncInteractivity();
  window.addEventListener('resize', syncInteractivity, { passive: true });
</script>
